# Copy to server/.env for local development. On Vercel, add these in
# Project Settings -> Environment Variables instead. Never commit real values.

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/luxurystay?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>

# Local development only: DNS resolvers Node should use if the Atlas SRV
# lookup fails with "querySrv ECONNREFUSED". Not needed on Vercel.
DNS_SERVERS=

# Comma-separated frontend origin(s) allowed by CORS, e.g. https://your-frontend.vercel.app
CLIENT_URL=

# Gmail account + App Password used to send password-reset OTPs
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Only used by `npm run create-admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
